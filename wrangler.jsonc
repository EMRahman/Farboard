{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farboard",
  "main": "relay/src/index.js",
  "compatibility_date": "2026-09-01",

  // The website. Cloudflare serves these files directly, free and without
  // limit; only /v1/... requests run the relay code.
  "assets": { "directory": "./public" },

  // Serve it at <name>.<subdomain>.workers.dev. Some ways of creating a Worker
  // leave that address switched off; this switches it on at every deploy.
  "workers_dev": true,
  // Per-version URLs are never made for Workers with Durable Objects anyway.
  "preview_urls": false,

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  // The Workers Free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Budget"] }],

  // Settings live in the Cloudflare dashboard (Settings → Variables and
  // Secrets), not here, so every copy starts private and redeploys keep them:
  //   OWNER_KEY, PUBLIC_HOSTING, DAILY_GAME_LIMIT, HOURLY_GAMES_PER_NETWORK,
  //   ALLOWED_ORIGINS. See relay/README.md.
  "keep_vars": true,
  "observability": { "enabled": true }
}
